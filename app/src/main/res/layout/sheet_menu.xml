<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sheet_bg"
    android:orientation="vertical"
    android:paddingBottom="14dp">

    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_handle" />

    <!-- ===== Хедър: кой е любимецът ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_grad_accent">

            <TextView
                android:id="@+id/petAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="28sp"
                tools:text="🐶" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/nameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    tools:text="Моки" />

                <TextView
                    android:id="@+id/renameBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/rename_title"
                    android:padding="4dp"
                    android:text="✏️"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/petTagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Игрив и верен" />
        </LinearLayout>

        <TextView
            android:id="@+id/changePetBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_soft"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/pets_change"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ===== Статове ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/statsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="🍎 72   ⚡ 84   💞 91" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/barFull"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            app:indicatorColor="#FF9A5C"
            app:trackColor="#26FFFFFF"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/barEnergy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            app:indicatorColor="#7BE0A8"
            app:trackColor="#26FFFFFF"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/barMood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            app:indicatorColor="#FF7BA9"
            app:trackColor="#26FFFFFF"
            app:trackCornerRadius="3dp"
            app:trackThickness="6dp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="4dp"
            android:paddingEnd="20dp">

            <!-- ===== ГРИЖА ===== -->
            <TextView
                style="@style/Text.EmotionPet.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_care" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4">

                <LinearLayout
                    android:id="@+id/feedBtn"
                    style="@style/Widget.EmotionPet.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/Text.EmotionPet.TileEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🍎" />

                    <TextView
                        style="@style/Text.EmotionPet.TileLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tile_feed" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/playBtn"
                    style="@style/Widget.EmotionPet.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/Text.EmotionPet.TileEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎾" />

                    <TextView
                        style="@style/Text.EmotionPet.TileLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tile_play" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/sleepBtn"
                    style="@style/Widget.EmotionPet.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        android:id="@+id/sleepIcon"
                        style="@style/Text.EmotionPet.TileEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="😴" />

                    <TextView
                        android:id="@+id/sleepLabel"
                        style="@style/Text.EmotionPet.TileLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tile_sleep" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/petBtn"
                    style="@style/Widget.EmotionPet.Tile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <TextView
                        style="@style/Text.EmotionPet.TileEmoji"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤗" />

                    <TextView
                        style="@style/Text.EmotionPet.TileLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tile_pet" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== ОБРАЗ ===== -->
            <TextView
                style="@style/Text.EmotionPet.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_look" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.EmotionPet.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_size" />

                    <TextView
                        android:id="@+id/sizeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        tools:text="120 dp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sizeSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="140"
                    android:progressDrawable="@drawable/bg_seek"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_thumb" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Text.EmotionPet.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_speed" />

                    <TextView
                        android:id="@+id/speedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        tools:text="1.0×" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/speedSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="170"
                    android:progressDrawable="@drawable/bg_seek"
                    android:splitTrack="false"
                    android:thumb="@drawable/bg_thumb" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/mirrorSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/label_mirror"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                style="@style/Text.EmotionPet.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/emoji_presets" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/emojiList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false" />

            <!-- ===== СТАЯ ===== -->
            <TextView
                style="@style/Text.EmotionPet.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_room" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4">

                <TextView
                    android:id="@+id/roomNight"
                    style="@style/Widget.EmotionPet.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/room_palette_night"
                    android:textColor="@color/choice_text" />

                <TextView
                    android:id="@+id/roomDawn"
                    style="@style/Widget.EmotionPet.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/room_palette_day"
                    android:textColor="@color/choice_text" />

                <TextView
                    android:id="@+id/roomMint"
                    style="@style/Widget.EmotionPet.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/room_palette_mint"
                    android:textColor="@color/choice_text" />

                <TextView
                    android:id="@+id/roomOcean"
                    style="@style/Widget.EmotionPet.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/room_palette_ocean"
                    android:textColor="@color/choice_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wallpaperBtn"
                    style="@style/Widget.EmotionPet.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/room_wallpaper" />

                <TextView
                    android:id="@+id/wallpaperClearBtn"
                    style="@style/Widget.EmotionPet.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="@string/room_wallpaper_clear" />
            </LinearLayout>

            <!-- ===== ДВИЖЕНИЕ ===== -->
            <TextView
                style="@style/Text.EmotionPet.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_motion" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/bounceSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_bounce"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/particlesSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_particles"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- ===== ИИ ===== -->
            <TextView
                style="@style/Text.EmotionPet.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_ai" />

            <LinearLayout
                android:id="@+id/aiBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_grad_accent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🤖"
                        android:textSize="21sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ai_settings"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/aiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Активно: Groq · llama-3.3-70b-versatile" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/text_secondary"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- ===== ДРУГИ ===== -->
            <TextView
                style="@style/Text.EmotionPet.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_other" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/keepAwakeSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keep_screen_on"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/overlaySwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/setting_overlay"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/resetBtn"
                style="@style/Widget.EmotionPet.Chip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/reset_pet" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
