<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sheet_bg"
    android:orientation="vertical"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/nameText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold"
            tools:text="Моки" />

        <TextView
            android:id="@+id/renameBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="6dp"
            android:text="✏️"
            android:textSize="17sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/statsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        tools:text="🍎 70  ⚡ 80  💞 90" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- ==== ГРИЖА ==== -->
            <TextView style="@style/Text.EmotionPet.Section" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/section_care" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/feedBtn"
                        style="@style/Widget.EmotionPet.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/action_feed" />

                    <TextView
                        android:id="@+id/playBtn"
                        style="@style/Widget.EmotionPet.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/action_play" />

                    <TextView
                        android:id="@+id/sleepBtn"
                        style="@style/Widget.EmotionPet.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/action_sleep" />

                    <TextView
                        android:id="@+id/petBtn"
                        style="@style/Widget.EmotionPet.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/action_pet" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ==== ОБРАЗ ==== -->
            <TextView style="@style/Text.EmotionPet.Section" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/section_look" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/Text.EmotionPet.Label" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/label_size" />

                <TextView
                    android:id="@+id/sizeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    tools:text="120 dp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sizeSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="300"
                android:paddingStart="0dp"
                android:paddingEnd="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/Text.EmotionPet.Label" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="@string/label_speed" />

                <TextView
                    android:id="@+id/speedValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    tools:text="1.0x" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/speedSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/mirrorSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/label_mirror"
                android:textColor="@color/text_primary"
                app:useMaterialThemeColors="true" />

            <TextView style="@style/Text.EmotionPet.Section" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/emoji_presets" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/emojiList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

            <TextView
                android:id="@+id/uploadBtn"
                style="@style/Widget.EmotionPet.Chip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/upload_image" />

            <TextView style="@style/Text.EmotionPet.Label" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:textSize="12sp" android:text="@string/upload_hint" />

            <!-- ==== СТАЯ ==== -->
            <TextView style="@style/Text.EmotionPet.Section" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/section_room" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:id="@+id/roomNight"
                    style="@style/Widget.EmotionPet.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/room_palette_night"
                    android:textColor="@color/choice_text" />

                <TextView
                    android:id="@+id/roomDawn"
                    style="@style/Widget.EmotionPet.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/room_palette_day"
                    android:textColor="@color/choice_text" />

                <TextView
                    android:id="@+id/roomMint"
                    style="@style/Widget.EmotionPet.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/room_palette_mint"
                    android:textColor="@color/choice_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wallpaperBtn"
                    style="@style/Widget.EmotionPet.Chip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/room_wallpaper" />

                <TextView
                    android:id="@+id/wallpaperClearBtn"
                    style="@style/Widget.EmotionPet.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="@string/room_wallpaper_clear" />
            </LinearLayout>

            <!-- ==== ИИ ==== -->
            <TextView style="@style/Text.EmotionPet.Section" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/section_ai" />

            <TextView
                android:id="@+id/aiBtn"
                style="@style/Widget.EmotionPet.Chip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/ai_settings" />

            <TextView
                android:id="@+id/aiStatus"
                style="@style/Text.EmotionPet.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="12sp"
                tools:text="Активно: OpenAI · gpt-4o-mini" />

            <!-- ==== ДРУГИ ==== -->
            <TextView style="@style/Text.EmotionPet.Section" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/section_other" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/keepAwakeSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/keep_screen_on"
                android:textColor="@color/text_primary"
                app:useMaterialThemeColors="true" />

            <TextView
                android:id="@+id/resetBtn"
                style="@style/Widget.EmotionPet.Chip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/reset_pet" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
