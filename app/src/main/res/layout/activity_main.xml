<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sheet_bg">

    <com.emotion.pet.PetView
        android:id="@+id/petView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD: аватар, име и трите стата -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="14dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_glass_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/avatarTile"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_soft">

            <TextView
                android:id="@+id/petAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="20sp"
                tools:text="🐶" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/petNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Моки" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barFull"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    app:indicatorColor="#FF9A5C"
                    app:trackColor="#26FFFFFF"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="5dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barEnergy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    app:indicatorColor="#7BE0A8"
                    app:trackColor="#26FFFFFF"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="5dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barMood"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    app:indicatorColor="#FF7BA9"
                    app:trackColor="#26FFFFFF"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="5dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/statsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            tools:text="72·84·91" />
    </LinearLayout>

    <!-- Долу вдясно: чат бутон -->
    <LinearLayout
        android:id="@+id/actionColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="20dp"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/chatBtn"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:background="@drawable/bg_grad_accent"
            android:clickable="true"
            android:elevation="10dp"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="22dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/chat"
                android:src="@drawable/ic_chat"
                app:tint="#1A1024" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="@string/chat"
                android:textColor="#1A1024"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Долна навигация: Начало / Задачи / Агенти / Памет / Още -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/surface_1"
        android:elevation="12dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_main" />

</FrameLayout>
