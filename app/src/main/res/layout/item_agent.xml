<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/surface_1"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="#26FFFFFF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/glyphBg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_soft">

            <TextView
                android:id="@+id/glyph"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="22sp"
                tools:text="🧠" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold"
                tools:text="ChatGPT" />

            <TextView
                android:id="@+id/tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="Креативност · Общи задачи" />
        </LinearLayout>

        <TextView
            android:id="@+id/selectBtn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_grad_accent"
            android:gravity="center"
            android:minWidth="84dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#1A1024"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="Избери" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
